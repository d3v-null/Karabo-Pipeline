diff --git a/lsmtool/facet.py b/lsmtool/facet.py
index d1837c3..87822bd 100644
--- a/lsmtool/facet.py
+++ b/lsmtool/facet.py
@@ -199,7 +199,12 @@ class Facet(object):
     def polygon(self):
         """Shapely Polygon object representing the facet's polygon in image
         coordinates."""
-        return Polygon(self.vertices_xy)
+        # [rapthor-patch: lsmtool Facet polygon buffer]
+        # Wide (e.g. MWA) fields can give self-intersecting facet polygons.
+        polygon = Polygon(self.vertices_xy)
+        if not polygon.is_valid:
+            polygon = polygon.buffer(0)
+        return polygon
 
     @property
     def x_center(self):
@@ -584,6 +589,20 @@ def voronoi(cal_coords, bounding_box, eps=1e-6):
         cal_coords, bounding_box
     )
 
+    # [rapthor-patch: voronoi fallback facet centers at bbox middle]
+    # Calibrators outside the tessellation bbox leave no points for scipy's
+    # Voronoi implementation. Keep one valid full-field facet per direction.
+    if len(points_centre) == 0:
+        if len(cal_coords) == 0:
+            return points_centre, np.zeros((0, 2)), []
+        minx, maxx, miny, maxy = bounding_box
+        vertices = np.array(
+            [[minx, miny], [maxx, miny], [maxx, maxy], [minx, maxy]], dtype=float
+        )
+        regions = [list(range(4)) for _ in range(len(cal_coords))]
+        center = np.array([[0.5 * (minx + maxx), 0.5 * (miny + maxy)]])
+        return np.tile(center, (len(cal_coords), 1)), vertices, regions
+
     # Compute Voronoi, sorting the output regions to match the order of the
     # input coordinates
     vor = scipy.spatial.Voronoi(points)
