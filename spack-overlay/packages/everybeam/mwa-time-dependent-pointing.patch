   array_position_ = antenna_pos_col(0);
 
+  // MWA_TILE_POINTING has one row per pointing, each with the dipole delays
+  // in effect over its INTERVAL (start and end time). Observations usually
+  // have a single row, but a MeasurementSet combining several pointings has
+  // one row per pointing.
   casacore::Table mwa_tile_pointing =
       ms.keywordSet().asTable("MWA_TILE_POINTING");
+  if (mwa_tile_pointing.nrow() == 0) {
+    throw std::runtime_error("The MWA_TILE_POINTING table has no rows");
+  }
   casacore::ArrayColumn<int> delays_col(mwa_tile_pointing, "DELAYS");
-  casacore::Array<int> delays_arr = delays_col(0);
-  casacore::Array<int>::contiter delays_arr_ptr = delays_arr.cbegin();
-  for (auto& delay : delays_) {
-    delay = *delays_arr_ptr;
-    ++delays_arr_ptr;
+  const bool has_interval =
+      mwa_tile_pointing.tableDesc().isColumn("INTERVAL");
+  std::optional<casacore::ArrayColumn<double>> interval_col;
+  if (has_interval) interval_col.emplace(mwa_tile_pointing, "INTERVAL");
+
+  for (casacore::rownr_t row = 0; row != mwa_tile_pointing.nrow(); ++row) {
+    const casacore::Array<int> delays_arr = delays_col(row);
+    if (delays_arr.nelements() != 16) {
+      throw std::runtime_error(
+          "MWA_TILE_POINTING row " + std::to_string(row) + " has " +
+          std::to_string(delays_arr.nelements()) +
+          " dipole delays, but must have 16");
+    }
+    std::array<double, 16> delays;
+    std::copy(delays_arr.cbegin(), delays_arr.cend(), delays.begin());
+
+    Pointing pointing{-std::numeric_limits<double>::infinity(),
+                      std::numeric_limits<double>::infinity(), 0};
+    if (has_interval) {
+      const casacore::Array<double> interval = (*interval_col)(row);
+      if (interval.nelements() == 2) {
+        pointing.start_time = *interval.cbegin();
+        pointing.end_time = *(interval.cbegin() + 1);
+      }
+    }
+    const auto found = std::find(delays_.begin(), delays_.end(), delays);
+    pointing.delays_index = found - delays_.begin();
+    if (found == delays_.end()) delays_.push_back(delays);
+    pointings_.push_back(pointing);
+  }
+  std::stable_sort(pointings_.begin(), pointings_.end(),
+                   [](const Pointing& a, const Pointing& b) {
+                     return a.start_time < b.start_time;
+                   });
+  tile_beams_.resize(delays_.size());
+}
+
+size_t MWA::DelaysIndex(double time) const {
+  if (pointings_.size() == 1) return pointings_.front().delays_index;
+  // The pointing whose interval contains the time; otherwise the nearest one.
+  size_t best = 0;
+  double best_distance = std::numeric_limits<double>::infinity();
+  for (size_t i = 0; i != pointings_.size(); ++i) {
+    const Pointing& p = pointings_[i];
+    const double distance = time < p.start_time ? p.start_time - time
+                            : time > p.end_time ? time - p.end_time
+                                                : 0.0;
+    if (distance < best_distance) {
+      best_distance = distance;
+      best = i;
+      if (distance == 0.0) break;
+    }
   }
+  return pointings_[best].delays_index;
 }
 
