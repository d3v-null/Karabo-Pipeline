diff --git a/python/CMakeLists.txt b/python/CMakeLists.txt
index 4aecb84..c67e763 100644
--- a/python/CMakeLists.txt
+++ b/python/CMakeLists.txt
@@ -78,8 +78,21 @@ if(NOT DEFINED Python3_LIBRARY_DIR)
   endif()
 endif()
 
+# The CMake build installs a Python extension but no package metadata. Install
+# metadata with the extension so Python dependency checkers can identify it.
+set(EVERYBEAM_DIST_INFO
+    "${CMAKE_CURRENT_BINARY_DIR}/everybeam-${EVERYBEAM_VERSION}.dist-info")
+file(MAKE_DIRECTORY "${EVERYBEAM_DIST_INFO}")
+file(
+  WRITE "${EVERYBEAM_DIST_INFO}/METADATA"
+  "Metadata-Version: 2.1\nName: everybeam\nVersion: ${EVERYBEAM_VERSION}\n"
+  "Summary: EveryBeam antenna response library\n")
+file(WRITE "${EVERYBEAM_DIST_INFO}/INSTALLER" "spack\n")
+
 # Install pyeverybeam in site-packages directory
 install(
   TARGETS pyeverybeam
   COMPONENT libraries
   LIBRARY DESTINATION ${Python3_LIBRARY_DIR})
+
+install(DIRECTORY "${EVERYBEAM_DIST_INFO}"
+        DESTINATION ${Python3_LIBRARY_DIR})
