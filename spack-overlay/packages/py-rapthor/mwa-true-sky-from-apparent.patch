+def _mwa_true_sky_from_apparent(beam_ms, apparent_file, true_file):
+    """[rapthor-mwa] Write true_file = apparent_file / MWA beam (Stokes I gain)."""
+    import casacore.tables as pt
+    import lsmtool
+    from lsmtool.operations_lib import apply_beam
+    iers.conf.auto_max_age = None  # offline: allow stale IERS predictions (as rapthor does elsewhere)
+    ms = beam_ms[0] if isinstance(beam_ms, (list, tuple)) else beam_ms
+    if not ms or not os.path.exists(str(apparent_file)):
+        return
+    with pt.table(f"{ms}::OBSERVATION", ack=False) as obs:
+        if obs.col("TELESCOPE_NAME")[0] != "MWA":
+            return
+    sm = lsmtool.load(str(apparent_file))
+    if len(sm) == 0:
+        return
+    flux = sm.getColValues("I")
+    gain = apply_beam(ms, np.ones(len(flux)), sm.getColValues("Ra"), sm.getColValues("Dec"))
+    gain = np.maximum(gain, float(os.environ.get("MWA_MIN_BEAM_GAIN", "0.02")))
+    sm.setColValues("I", flux / gain)
+    sm.write(str(true_file), clobber=True)
+    print(f"[rapthor-mwa] true sky = apparent / beam for {len(flux)} components "
+          f"(gain {gain.min():.3f}-{gain.max():.3f}; {flux.sum():.1f} -> {(flux / gain).sum():.1f} Jy)")
+
