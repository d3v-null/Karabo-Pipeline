+    # [rapthor-mwa: first-pass guard] lsmtool can raise (e.g. transfer_patches
+    # ValueError) when PyBDSF finds nothing usable on the Sun; treat as 0 sources
+    try:
+        nsources = filter_skymodel(
+            flat_noise_image,
+            true_sky_image,
+            true_sky_skymodel,
+            apparent_sky_skymodel,
+            beam_ms=beamMS,
+            vertices_file=vertices_file,
+            input_bright_skymodel=bright_true_sky_skymodel,
+            output_apparent_sky=f'{output_root}.apparent_sky.txt',
+            output_true_sky=f'{output_root}.true_sky.txt',
+            output_flat_noise_rms=f'{output_root}.flat_noise_rms.fits',
+            output_true_rms=f'{output_root}.true_sky_rms.fits',
+            output_catalog=f'{output_root}.source_catalog.fits',
+            source_finder=source_finder,
+            thresh_isl=threshisl,
+            thresh_pix=threshpix,
+            rmsbox=rmsbox,
+            rmsbox_bright=rmsbox_bright,
+            adaptive_thresh=adaptive_thresh,
+            filter_by_mask=filter_by_mask,
+            keep_mask=True,
+            ncores=ncores)
+    except Exception as e:  # noqa
+        print('[rapthor-mwa] first filter_skymodel pass failed:', e)
+        nsources = 0
+
+    # [rapthor-mwa: solar fallback] PyBDSF's adaptive rms boxes treat a bright,
+    # resolved Sun as "noise" and can find zero sources, which leaves no mask
+    # and crashes the next mosaic step.  Retry with large, non-adaptive rms
+    # boxes and lower thresholds; if still nothing, build a simple threshold
+    # mask and keep the unfiltered WSClean component model.
+    if nsources == 0:
+        print('[rapthor-mwa] PyBDSF found 0 sources; retrying with global rms boxes')
+        try:
+            nsources = filter_skymodel(
+                flat_noise_image, true_sky_image, true_sky_skymodel, apparent_sky_skymodel,
+                beam_ms=beamMS, vertices_file=vertices_file, input_bright_skymodel=bright_true_sky_skymodel,
+                output_apparent_sky=f'{output_root}.apparent_sky.txt', output_true_sky=f'{output_root}.true_sky.txt',
+                output_flat_noise_rms=f'{output_root}.flat_noise_rms.fits', output_true_rms=f'{output_root}.true_sky_rms.fits',
+                output_catalog=f'{output_root}.source_catalog.fits', source_finder=source_finder,
+                thresh_isl=3.0, thresh_pix=4.0, rmsbox=(1000, 300), rmsbox_bright=(1000, 300),
+                adaptive_thresh=1e9, filter_by_mask=filter_by_mask, keep_mask=True, ncores=ncores)
+        except Exception as e:  # noqa
+            print('[rapthor-mwa] retry failed:', e)
+            nsources = 0
+    if nsources == 0:
+        print('[rapthor-mwa] still 0 sources; writing threshold mask and unfiltered model')
+        import shutil
+        import numpy as np
+        from astropy.io import fits
+        with fits.open(flat_noise_image) as h:
+            data = h[0].data
+            hdr = h[0].header
+        d = data.squeeze()
+        finite = d[np.isfinite(d)]
+        med = np.median(finite)
+        mad = np.median(np.abs(finite - med)) * 1.4826
+        mask = np.zeros_like(data, dtype=np.float32)
+        mask[...] = (data > med + 5.0 * mad).astype(np.float32)
+        mask_file = os.path.basename(true_sky_image) + '.mask.fits'
+        fits.writeto(mask_file, mask, hdr, overwrite=True)
+        # rapthor needs a Patch column: group all components into one patch
+        import lsmtool
+        for src, dst in ((true_sky_skymodel, f'{output_root}.true_sky.txt'),
+                         (apparent_sky_skymodel, f'{output_root}.apparent_sky.txt')):
+            try:
+                sm = lsmtool.load(str(src))
+                sm.group('single', root='Sun')
+                sm.setPatchPositions(method='wmean')
+                sm.write(dst, clobber=True)
+            except Exception as e:  # noqa
+                print('[rapthor-mwa] lsmtool grouping failed, copying raw model:', e)
+                shutil.copy(src, dst)
+        print(f'[rapthor-mwa] mask {mask_file}: {int(mask.sum())} pixels above 5 sigma (mad {mad:.3g})')
 
     # Write out number of sources found by PyBDSF for later use
     output_diagnostics = f'{output_root}.image_diagnostics.json'
