     true_sky_skymodel = true_sky_skymodel if os.path.exists(true_sky_skymodel) else None
     apparent_sky_skymodel = apparent_sky_skymodel if os.path.exists(apparent_sky_skymodel) else None
 
-    nsources = filter_skymodel(
-        flat_noise_image,
-        true_sky_image,
