 namespace dp3::steps {
 
+namespace {
+using ModelBuffer = aocommon::xt::UTensor<std::complex<double>, 3>;
+
+/// Process-wide pool of the per-thread model buffers used by
+/// PredictWithSourceParallelization(). For MWA-sized data each buffer is
+/// hundreds of MB. Allocating them for every time step made the kernel map,
+/// zero and unmap them again (with TLB shootdowns on every core), which
+/// dominated predicts with many threads. The pool is shared by all OnePredict
+/// steps, so that e.g. the directions of DDECal do not each hold on to a set.
+class ModelBufferPool {
+ public:
+  std::vector<std::unique_ptr<ModelBuffer>> Take(size_t n) {
+    std::vector<std::unique_ptr<ModelBuffer>> buffers;
+    buffers.reserve(n);
+    std::lock_guard lock(mutex_);
+    while (buffers.size() != n) {
+      if (free_.empty()) {
+        buffers.emplace_back(std::make_unique<ModelBuffer>());
+      } else {
+        buffers.emplace_back(std::move(free_.back()));
+        free_.pop_back();
+      }
+    }
+    return buffers;
+  }
+
+  void Return(std::vector<std::unique_ptr<ModelBuffer>>& buffers) {
+    std::lock_guard lock(mutex_);
+    for (std::unique_ptr<ModelBuffer>& buffer : buffers) {
+      free_.emplace_back(std::move(buffer));
+    }
+    buffers.clear();
+  }
+
+ private:
+  std::mutex mutex_;
+  std::vector<std::unique_ptr<ModelBuffer>> free_;
+};
+
+ModelBufferPool& GetModelBufferPool() {
+  static ModelBufferPool pool;
+  return pool;
+}
